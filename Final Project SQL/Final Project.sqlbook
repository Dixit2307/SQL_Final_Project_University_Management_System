-- SQLBook: Markup
### Q - Retrive Students Who enrolles After 2022
-- SQLBook: Code
-- Active: 1787030903737@@127.0.0.1@3306@univarsity_management_system
SELECT * FROM Student
WHERE Enrollment_date > '2022-12-31';
-- SQLBook: Markup
### Q - Retrive Course Offerded by the Mathematics department With Limite of 5 courses
-- SQLBook: Code
-- Active: 1787030903737@@127.0.0.1@3306@univarsity_management_system
SELECT 
    c.Course_id,
    c.Course_name,
    c.Credits,
    d.Department_name
FROM Courses c
JOIN Department d ON c.Department_id = d.Department_id
WHERE d.Department_name LIKE '%Mathematics%'
LIMIT 5;

-- SQLBook: Markup
### Q - Get the number of students enrolled in each course, filtering with a limit of 5 courses
-- SQLBook: Code
SELECT 
    c.Course_id,
    c.Course_name,
    COUNT(e.Student_id) AS Total_Students
FROM Courses c 
LEFT JOIN Enrollments e ON c.Course_id = e.Course_id
GROUP BY c.Course_id, c.Course_name
ORDER BY Total_Students DESC
LIMIT 5;
-- SQLBook: Markup
#### Find students who are  enrolled in both Introduction to SQL and Data Structures
-- SQLBook: Code
SELECT 
    s.Student_id,
    s.First_name,
    s.Last_name,
    s.Email
FROM Student s
JOIN Enrollments e ON s.Student_id = e.Student_id
JOIN Courses c ON e.Course_id = c.Course_id
WHERE c.Course_name IN ('Structural Analysis', 'Database Management Systems')
GROUP BY s.Student_id, s.First_name, s.Last_name, s.Email
HAVING COUNT(DISTINCT c.Course_name) = 2;
-- SQLBook: Markup
#### Q Find students who are enrolled in Introduction to SQL or Data Structures
-- SQLBook: Code
SELECT DISTINCT
    s.Student_id,
    s.First_name,
    s.Last_name,
    s.Email
FROM Student s
JOIN Enrollments e ON s.Student_id = e.Student_id
JOIN Courses c ON e.Course_id = c.Course_id
WHERE c.Course_name IN ('Structural Analysis', 'Database Management Systems');
-- SQLBook: Markup
#### Q - Calculate the average number of credits for all courses
-- SQLBook: Code
SELECT 
    AVG(Credits) AS Average_Credits
FROM Courses;
-- SQLBook: Markup
#### Q - Find the maximum salary of instructors in Computer Science Department
-- SQLBook: Code

-- SQLBook: Markup
#### Q - Count the number of students enrolled in each department
-- SQLBook: Code
SELECT 
    d.Department_id,
    d.Department_name,
    COUNT(DISTINCT e.Student_id) AS Total_Students
FROM Department d
LEFT JOIN Courses c ON d.Department_id = c.Department_id
LEFT JOIN Enrollments e ON c.Course_id = e.Course_id
GROUP BY d.Department_id, d.Department_name
ORDER BY Total_Students DESC;
    
-- SQLBook: Markup
#### Q - INNER JOIN : Retrieve students and their corresponding courses
-- SQLBook: Code
SELECT 
    s.Student_id,
    CONCAT(s.First_name, ' ', s.Last_name) AS Student_Name,
    s.Email,
    c.Course_id,
    c.Course_name,
    c.Credits,
    e.Enrollment_date
FROM Student s
INNER JOIN Enrollments e ON s.Student_id = e.Student_id
INNER JOIN Courses c ON e.Course_id = c.Course_id
ORDER BY s.Student_id, c.Course_id;
-- SQLBook: Markup
#### Q - LEFT JOIN : Retrieve all students and their corresponding courses , if any
-- SQLBook: Code
SELECT 
    s.Student_id,
    CONCAT(s.First_name, ' ', s.Last_name) AS Student_Name,
    s.Email,
    c.Course_id,
    c.Course_name,
    c.Credits,
    e.Enrollment_date
FROM Student s
LEFT JOIN Enrollments e ON s.Student_id = e.Student_id
LEFT JOIN Courses c ON e.Course_id = c.Course_id
ORDER BY s.Student_id, c.Course_id;
-- SQLBook: Markup
#### Q - Subquery : Find students enrolled in courses that have more than 10 students
-- SQLBook: Code
SELECT DISTINCT
    s.Student_id,
    CONCAT(s.First_name, ' ', s.Last_name) AS Student_Name,
    s.Email
FROM Student s
JOIN Enrollments e ON s.Student_id = e.Student_id
WHERE e.Course_id IN (
    SELECT Course_id
    FROM Enrollments
    GROUP BY Course_id
    HAVING COUNT(Student_id) > 1
);
-- SQLBook: Markup
#### Q - Extract the year from the EnrollmentDate of students
-- SQLBook: Code

SELECT 
    Student_id,
    First_name,
    Last_name,
    Enrollment_date,
    YEAR(Enrollment_date) AS Enrollment_Year
FROM Student;
-- SQLBook: Markup
#### Q - Concatenate the instructor's first and last name
-- SQLBook: Code
SELECT 
    Instructor_id,
    CONCAT(First_name, ' ', Last_name) AS Full_Name,
    Email,
    Department_id
FROM Instructors;
-- SQLBook: Markup
#### Q - Calculate the running total of Students enrolled in courses
-- SQLBook: Code
SELECT 
    e.Enrollment_id,
    e.Enrollment_date,
    e.Student_id,
    e.Course_id,
    COUNT(e.Student_id) OVER (ORDER BY e.Enrollment_date, e.Enrollment_id) AS Running_Total_Students
FROM Enrollments e;
-- SQLBook: Markup
#### Q - Label Students as 'Senior' or 'Junior' based on their year of enrollment
(If the enrollment date is more than 4 years from the currentdate, put the label "Senior" otherwise "Junior")
-- SQLBook: Code
SELECT 
    Student_id,
    First_name,
    Last_name,
    Enrollment_date,
    CASE 
        WHEN Enrollment_date < DATE_SUB(CURDATE(), INTERVAL 4 YEAR) THEN 'Senior'
        ELSE 'Junior'
    END AS Student_Status
FROM Student;