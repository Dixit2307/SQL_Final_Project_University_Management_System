# Final Project
-- SQLBook: Markup
#### Database Creation and Use
-- SQLBook: Code
-- Active: 1787030903737@@127.0.0.1@3306@univarsity_management_system
CREATE DATABASE IF NOT EXISTS Univarsity_management_System;

-- SQLBook: Code
-- Active: 1787030903737@@127.0.0.1@3306@univarsity_management_syste
USE Univarsity_management_System;
-- SQLBook: Markup
#### Creation of Department Table
-- SQLBook: Code
CREATE TABLE Department(
    Department_id INT PRIMARY KEY,
    Department_name VARCHAR(50)
);
-- SQLBook: Markup
#### Creation of Student Table
-- SQLBook: Code
CREATE TABLE Student(
    Student_id INT PRIMARY KEY,
    First_name VARCHAR(50) NOT NULL,
    Last_name VARCHAR(50) NOT NULL,
    Email VARCHAR(100) ,
    Birth_date DATE,
    Enrollment_date DATE
);
-- SQLBook: Markup
#### Creation of Courses Table
-- SQLBook: Code
CREATE TABLE Courses(
    Course_id INT PRIMARY KEY,
    Course_name VARCHAR(100) NOT NULL,
    Department_id INT,
    Credits INT,
    FOREIGN KEY (Department_id) REFERENCES Department(Department_id) ON DELETE CASCADE
);
-- SQLBook: Markup
#### Creation Of Instructors Table
-- SQLBook: Code
CREATE TABLE Instructors(
    Instructor_id INT PRIMARY KEY,
    First_name VARCHAR(50) NOT NULL,
    Last_name VARCHAR(50) NOT NULL,
    Email VARCHAR(100) UNIQUE,
    Department_id INT,
    FOREIGN KEY (Department_id) REFERENCES Department(Department_id) ON DELETE SET NULL
);
-- SQLBook: Markup
#### Creation of Enrollments Table
-- SQLBook: Code
CREATE TABLE Enrollments(
    Enrollment_id INT PRIMARY KEY,
    Student_id INT NOT NULL,
    Course_id INT NOT NULL,
    Enrollment_date DATE NOT NULL,
    Grade VARCHAR(2) DEFAULT NULL,
    FOREIGN KEY (Student_id) REFERENCES Student(Student_id) ON DELETE CASCADE,
    FOREIGN KEY (Course_id) REFERENCES Courses(Course_id) ON DELETE CASCADE
);
